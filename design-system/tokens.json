  "typography": {
    "family": {
      "base": "'Inter', 'Noto Sans Arabic', 'Noto Sans Devanagari', system-ui, sans-serif",
      "display": "'Space Grotesk', 'Noto Sans Arabic', 'Noto Sans Devanagari', 'Inter', system-ui, sans-serif",
      "arabic": "'Noto Sans Arabic', 'Inter', system-ui, sans-serif",
      "devanagari": "'Noto Sans Devanagari', 'Inter', system-ui, sans-serif",
      "numeric": "same as base with font-variant-numeric: tabular-nums"
    },
    "scriptScaleFactor": {
      "latin": 1.0,
      "arabic": 1.06,
      "devanagari": 1.03,
      "notes": "Applied via html[lang] rules; Arabic and Devanagari read slightly small at identical nominal sizes"
    },
    "scale": {
      "display-numeral": { "size": "clamp(2.5rem, 6vw, 4.5rem)", "lineHeight": 1.05, "weight": 650, "tabularNums": true, "tracking": "-0.01em" },
      "display-heading": { "size": "clamp(1.75rem, 3.5vw, 2.5rem)", "lineHeight": 1.15, "weight": 700 },
      "h2": { "size": "1.5rem", "lineHeight": 1.25, "weight": 650 },
      "h3": { "size": "1.25rem", "lineHeight": 1.25, "weight": 600 },
      "body-lg": { "size": "1.125rem", "lineHeight": 1.55, "weight": 400 },
      "body": { "size": "1rem", "lineHeight": 1.5, "weight": 400 },
      "body-sm": { "size": "0.875rem", "lineHeight": 1.45, "weight": 400 },
      "caption": { "size": "0.75rem", "lineHeight": 1.4, "weight": 400 }
    },
    "loading": {
      "format": "WOFF2 variable fonts",
      "strategy": "unicode-range per-script @font-face, font-display: swap, preload Latin subset only",
      "minimumInputSize": "16px"
    }
  },
  "spacing": {
    "base": "4px",
    "scale": [4, 8, 12, 16, 24, 32, 48, 64, 96],
    "rules": "8px jumps for section rhythm; 4px only inside components"
  },
  "radius": {
    "base": "0.625rem",
    "scale": {
      "sm": "6px (inputs, tags)",
      "md": "8px (buttons)",
      "lg": "10px (cards)",
      "xl": "16px (hero card, modals)",
      "full": "9999px (chips, toggle pills)"
    }
  },
  "elevation": {
    "border-first": true,
    "levels": {
      "0": "flat, 1px border only",
      "1": "card: border + 0 1px 2px rgb(0 0 0 / 0.05), 0 4px 12px rgb(0 0 0 / 0.06)",
      "2": "popover and sticky bar: border + 0 4px 8px rgb(0 0 0 / 0.08), 0 12px 28px rgb(0 0 0 / 0.12)"
    },
    "darkModeRule": "lighter surfaces plus borders instead of heavier shadows"
  },
  "motion": {
    "durations": { "instant": 100, "fast": 200, "moderate": 300, "slow": 500 },
    "easing": {
      "entrance": "cubic-bezier(0, 0, 0.2, 1) ease-out",
      "exit": "cubic-bezier(0.4, 0, 1, 1) ease-in",
      "settle": "spring, range bar fill only"
    },
    "reducedMotion": "prefers-reduced-motion: all transitions minimized; hero count-up renders final value instantly"
  },
  "layout": {
    "contentMaxWidth": "1200px",
    "wizardColumnMaxWidth": "640px",
    "breakpoints": { "sm": 640, "md": 768, "lg": 1024, "xl": 1280 },
    "grid": "12-column desktop for results bento; single-column wizard"
  },
  "iconography": {
    "library": "Lucide",
    "license": "ISC",
    "strokeWidth": 1.75,
    "size": 20,
    "rtlRule": "mirror direction-relative icons (back, next, chevrons) with scaleX(-1); never mirror logos, media controls, clocks"
  },
  "zIndex": { "base": 0, "sticky": 100, "header": 200, "popover": 300, "toast": 400, "dialog": 500 },
  "locale": {
    "launch": ["en"],
    "planned": ["ar", "hi", "id", "es", "fr", "pt", "ru", "zh"],
    "rtlLocales": ["ar"],
    "numberFormatting": "Intl.NumberFormat with explicit locale and ISO 4217 code; currencyDisplay symbol; tabular-nums; end-aligned numeric columns",
    "dirAttribute": "document root dir and lang per locale"
  }
}
