{
  "name": "expatrate",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "benchmarks": "node scripts/generate-benchmarks.mjs",
    "build": "astro build",
    "data:world": "node scripts/sync-world-data.mjs",
    "dev": "astro dev --port 4573",
    "fx:snapshot": "node scripts/refresh-fx-snapshot.mjs",
    "lint": "stylelint \"src/**/*.css\"",
    "preview": "astro preview --port 4574",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:watch": "vitest",
    "tokens": "node scripts/generate-tokens.mjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.1.0",
    "astro": "^5.12.0",
    "mammoth": "^1.12.2",
    "pdfjs-dist": "^6.3.289",
    "tailwindcss": "^4.1.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.0",
    "@playwright/test": "^1.53.0",
    "@types/node": "^26.4.1",
    "stylelint": "^16.19.0",
    "stylelint-config-standard": "^38.0.0",
    "typescript": "^5.8.0",
    "vitest": "^3.2.0"
  }
}
