---
import '../../styles/global.css';
import '../../styles/wizard.css';
import '../../styles/seo.css';
import { seoCountries, countryHubUrl, breadcrumbLd, webAppLd, organizationLd, SITE_URL, alternateLinks } from '../../lib/seo';
import { t } from '../../i18n';
import Pwa from '../../components/Pwa.astro';

const countries = seoCountries();
const crumbs = [
  { name: t('seo.breadcrumbHome'), url: `${SITE_URL}/` },
  { name: 'Salaries', url: `${SITE_URL}/salaries/` },
];
---

<!doctype html>
<html lang="en" dir="ltr">
  <head>
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-32.png" type="image/png" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Salary benchmarks by country</title>
    <meta name="description" content={`Verified salary benchmarks for ${countries.length} countries, every number cited. For every other country, a purchasing-power floor.`} />
    <link rel="canonical" href={`${SITE_URL}/salaries/`} />
    {alternateLinks('/salaries/').map((a) => <link rel="alternate" hreflang={a.hreflang} href={a.href} />)}
    <script type="application/ld+json" set:html={JSON.stringify(webAppLd())} />
    <script type="application/ld+json" set:html={JSON.stringify(organizationLd())} />
    <script type="application/ld+json" set:html={JSON.stringify(breadcrumbLd(crumbs))} />
    <meta property="og:title" content="Salary benchmarks by country" />
    <meta property="og:url" content={`${SITE_URL}/salaries/`} />
    <meta property="og:description" content="Browse verified expat salary benchmarks by country, role family, and seniority, with sources shown." />
    <meta property="og:type" content="website" />
    <meta property="og:image" content="https://expatrate.pages.dev/og-default.png" />
    <meta name="twitter:card" content="summary_large_image" />
    <Pwa />
  </head>
  <body class="min-h-screen bg-background font-base text-foreground">
    <div class="page-shell">
      <a class="skip-link" href="#main">{t('home.skip')}</a>
      <header class="site-header">
        <a class="brand" href="/">
          <span class="brand-mark" aria-hidden="true">%</span>
          <span class="brand-name">ExpatRate</span>
        </a>
        <p class="site-header-tag">Free · No sign-up · Runs in your browser</p>
      </header>
    <main id="main">

      <article class="seo-shell">
        <nav class="seo-breadcrumb" aria-label="Breadcrumb">
          <a href="/">{t('seo.breadcrumbHome')}</a> ›
          <span aria-current="page">Salaries</span>
        </nav>

        <h1 class="seo-h1">Salary benchmarks by country</h1>
        <p class="seo-answer">
          Verified market data for {countries.length} countries, with every number traced to its source.
          For any other country, the purchasing-power floor still works.
        </p>

        <h2 class="seo-h2">Countries with verified data</h2>
        <ul class="seo-list">
          {countries.map((country) => (
            <li>
              <a href={countryHubUrl(country.slug)}>{country.name} ({country.families} role families)</a>
            </li>
          ))}
        </ul>

        <p class="seo-cta">
          <a href="/">Get your personal quote.</a>
        </p>
      </article>

      </main>
    <footer class="site-footer">
        <p>Estimates from public market data, indicative only. Not financial, tax, or legal advice.</p>
        <p>© {new Date().getFullYear()} ExpatRate. Free, no account required.</p>
      </footer>
    </div>
  </body>
</html>
