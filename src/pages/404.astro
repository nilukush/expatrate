---
import '../styles/global.css';
import '../styles/wizard.css';
import '../styles/seo.css';
import { t, setLocale } from '../i18n';
import Pwa from '../components/Pwa.astro';

setLocale('en');
const year = new Date().getFullYear();
---

<!doctype html>
<html lang="en" dir="ltr">
  <head>
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-32.png" type="image/png" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Page not found | ExpatRate</title>
    <meta name="robots" content="noindex" />
    <link rel="preload" href="/fonts/inter-latin-var.woff2" as="font" type="font/woff2" crossorigin />
    <Pwa />
  </head>
  <body class="min-h-screen bg-background font-base text-foreground">
    <div class="page-shell">
      <a class="skip-link" href="#main">{t('home.skip')}</a>
    <main id="main">
      <article class="seo-shell">
        <p class="seo-breadcrumb"><a href="/">ExpatRate</a></p>
        <h1 class="seo-h1">Page not found</h1>
        <p class="seo-answer">The page you asked for does not exist. The address may be mistyped, or the page may have moved.</p>
        <p class="seo-answer"><a href="/">Start a new salary check</a>.</p>
      </article>
      </main>
    <footer class="site-footer">
        <p>{t('home.footerAdvice')}</p>
        <p>{t('home.footerRights', { year })}</p>
      </footer>
    </div>
  </body>
</html>
